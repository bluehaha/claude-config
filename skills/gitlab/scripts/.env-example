# GitLab host (your instance root, no trailing slash or /api path)
GITLAB_HOST=https://gitlab.example.com

# Personal Access Token
# Generate at: GitLab > User Settings > Access Tokens
# Scope: "api" (needed to post comments). Use "read_api" if you only ever read.
GITLAB_TOKEN=glpat-your_token_here

# Optional: default project path so you can pass a bare MR iid (e.g. `get 4230`)
# GITLAB_DEFAULT_PROJECT=mygroup/myrepo
