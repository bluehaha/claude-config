# ClickUp Personal API Token
# 1. In ClickUp, open Settings > Apps
# 2. Under "API Token", click Generate (or copy your existing token). It starts with 'pk_'
# 3. Paste it below
CLICKUP_API_TOKEN=pk_your_token_here

# Default Workspace (team) ID, used for custom-task-id lookups when the input
# URL doesn't carry one. Team-scoped URLs like /t/3716037/86eyc0enm already
# include the team_id and take precedence over this value.
# Set this if you paste bare task ids or plain /t/{id} URLs.
DEFAULT_TEAM_ID=3716037
